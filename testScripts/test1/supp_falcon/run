#!/usr/bin/env bash
# run_test5_falcon.sh — Experiment 5: FN-DSA baseline extension (Falcon-512 / Falcon-1024)
#
# Reuse the authentication latency test framework from step2/ex2 or step4,
# adding Falcon-512 and Falcon-1024 on top of the existing Falcon baseline.
#
# Usage:
#   sudo ./run_test5_falcon.sh

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BACKENDS_DIR="$ROOT_DIR/testScripts/backends"

# ---- Must be set before sourcing sshd_test_harness.sh ----
TEST_PORT="${TEST_PORT:-42600}"

source "$BACKENDS_DIR/sshd_test_harness.sh"
source "$BACKENDS_DIR/netem_setup.sh"

# ---- Parameters ----
RTT_MS="${RTT_MS:-67}"
INITCWND_MSS="${INITCWND_MSS:-10}"
NETEM_IFACE="${NETEM_IFACE:-lo}"
SUDO_BIN="${SUDO_BIN:-sudo}"
ITERATIONS="${ITERATIONS:-500}"
ROUNDS="${ROUNDS:-10}"

# ---- Fix TEST_USER becoming root under sudo ----
SUDO_USER="${SUDO_USER:-$USER}"
TEST_USER="${TEST_USER:-$SUDO_USER}"
TEST_HOST="${TEST_HOST:-127.0.0.1}"
KEEP_WORKDIR="${KEEP_WORKDIR:-1}"

WORK_DIR="${WORK_DIR:-$ROOT_DIR/testScripts/.work-supp-test5}"
RESULT_DIR="$SCRIPT_DIR/results"

# ---- Prerequisite checks ----
check_ssh_binaries || exit 1

# ---- Cleanup leftover processes ----
# Kill leftover sshd processes to free the port
pkill -f "sshd.*-f.*${WORK_DIR}" 2>/dev/null || true
# Cleanup leftover cgroups
find /sys/fs/cgroup -maxdepth 1 -name "ssh-*" -type d 2>/dev/null | while read d; do rmdir "$d" 2>/dev/null || true; done
sleep 1
check_netem_deps || exit 1
mkdir -p "$WORK_DIR" "$RESULT_DIR"

# ---- Keys ----
# server hostkey: Ed25519 (consistent with paper Figure 3)
HOST_KEY_ED25519="$(gen_host_key_ed25519 "$WORK_DIR")"
KNOWN_HOSTS="$WORK_DIR/known_hosts"
gen_known_hosts "$WORK_DIR" "$HOST_KEY_ED25519.pub" >/dev/null

AUTHORIZED_KEYS="$WORK_DIR/authorized_keys"

# ---- Generate test keys (Falcon + baseline Ed25519 / ML-DSA-65) ----
echo "[INFO] generating test keys (ed25519, mldsa-44, mldsa-65, mldsa-87, falcon512, falcon1024)..."

for alg in ed25519 mldsa-44 mldsa-65 mldsa-87 falcon512 falcon1024; do
  if "$SSH_BIN" -Q key 2>/dev/null | grep -q "$alg"; then
    keyfile="$WORK_DIR/id_${alg}"
    if [[ ! -f "$keyfile" ]]; then
      "$SSH_KEYGEN_BIN" -q -t "$alg" -N "" -f "$keyfile" >/dev/null 2>&1 || {
        echo "[WARN] ssh-keygen -t $alg failed; algorithm may not be available"
        continue
      }
    fi
    if [[ -f "${keyfile}.pub" ]]; then
      cat "${keyfile}.pub" >> "$AUTHORIZED_KEYS"
      echo "[INFO] $alg key generated"
    fi
  else
    echo "[WARN] $alg not in ssh -Q key; skipping"
  fi
done

# ---- Fix key file ownership (ssh-keygen generates as root, chown to real user) ----
chown "$TEST_USER" "$WORK_DIR"/id_* 2>/dev/null || true
echo "[INFO] key ownership fixed for $TEST_USER"

# ---- sshd configuration ----
SSHD_CFG="$WORK_DIR/sshd.conf"
SSHD_LOG="$WORK_DIR/sshd.log"

cat > "$SSHD_CFG" <<EOF
Port $TEST_PORT
ListenAddress $TEST_HOST
PidFile $WORK_DIR/sshd.pid
HostKey $HOST_KEY_ED25519
HostKeyAlgorithms ssh-ed25519
KexAlgorithms mlkem768x25519-sha256
LogLevel ERROR
SshdSessionPath $SSHD_SESSION_BIN
SshdAuthPath $SSHD_AUTH_BIN
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PermitRootLogin no
PubkeyAuthentication yes
PubkeyAcceptedAlgorithms ssh-ed25519,ssh-mldsa-44,ssh-mldsa-65,ssh-mldsa-87,ssh-falcon512,ssh-falcon1024
AuthorizedKeysFile $AUTHORIZED_KEYS
MaxStartups 256
MaxSessions 1
LoginGraceTime 120
StrictModes no
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
PrintMotd no
EOF

# ---- Algorithm list (baseline + Falcon, single run to eliminate environment drift) ----
ALG_LIST=""

for alg in ed25519 mldsa-44 mldsa-65 mldsa-87 falcon512 falcon1024; do
  if "$SSH_BIN" -Q key 2>/dev/null | grep -q "$alg"; then
    ALG_LIST="$ALG_LIST $alg"
  fi
done

if [[ -z "$ALG_LIST" ]]; then
  echo "[ERR] No test algorithms available (check liboqs build)"
  echo "[HINT] Run: ssh -Q key"
  exit 1
fi

echo "[INFO] Testing algorithms: $ALG_LIST"

# ---- Results files ----
RAW_CSV="$RESULT_DIR/auth_raw.csv"
SUMMARY_CSV="$RESULT_DIR/auth_summary.csv"

echo "alg,rtt_ms,round,iteration,latency_ms,success,retcode" > "$RAW_CSV"
echo "alg,rtt_ms,total,successes,p50_ms,p95_ms,mean_ms" > "$SUMMARY_CSV"

# ---- netem RTT (consistent with paper Figure 3: RTT≈67ms) ----
if [[ "$RTT_MS" -gt 0 ]]; then
  set_netem_delay "$NETEM_IFACE" "$RTT_MS"
fi

# ---- Run tests ----
"$SSHD_BIN" -D -f "$SSHD_CFG" -E "$SSHD_LOG" &
SSHD_PID=$!
sleep 1

cleanup_sshd() {
  if [[ -n "${SSHD_PID:-}" ]] && kill -0 "$SSHD_PID" 2>/dev/null; then
    kill "$SSHD_PID" 2>/dev/null || true
    wait "$SSHD_PID" 2>/dev/null || true
  fi
  clear_netem "$NETEM_IFACE"
}
trap cleanup_sshd EXIT

echo "[INFO] sshd PID=$SSHD_PID"

# ---- Prebuild client_opts for each algorithm (needed for fast switching in interleaved polling) ----
declare -A ALG_KEYFILE ALG_OPTS
for alg in $ALG_LIST; do
  keyfile="$WORK_DIR/id_${alg}"
  ALG_KEYFILE[$alg]="$keyfile"
  ALG_OPTS[$alg]="-o StrictHostKeyChecking=no -o UserKnownHostsFile=$KNOWN_HOSTS -o BatchMode=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no -o ConnectTimeout=30 -o ControlMaster=no -o ControlPersist=no -o KexAlgorithms=mlkem768x25519-sha256 -o HostKeyAlgorithms=ssh-ed25519 -o PubkeyAcceptedAlgorithms=+ssh-ed25519,ssh-mldsa-44,ssh-mldsa-65,ssh-mldsa-87,ssh-falcon512,ssh-falcon1024 -o PreferredAuthentications=publickey -o IdentityFile=$keyfile -o LogLevel=ERROR -p $TEST_PORT"
done

# ---- Interleaved polling: outer iteration, inner random rotation of all algorithms ----
# Each algorithm runs once per round; drift is evenly amortized
for ((i=0; i<ITERATIONS; i++)); do
  # Randomly shuffle algorithm order for this round (using shuf, fallback to sort -R)
  if command -v shuf >/dev/null 2>&1; then
    shuffled=$(echo "$ALG_LIST" | tr ' ' '\n' | shuf | tr '\n' ' ')
  else
    shuffled=$(echo "$ALG_LIST" | tr ' ' '\n' | sort -R | tr '\n' ' ')
  fi

  for alg in $shuffled; do
    start_ep=""; end_ep=""; lat_ms=""; retcode=0; success=0
    start_ep="$(date +%s.%N)"
    # shellcheck disable=SC2086
    "$SSH_BIN" ${ALG_OPTS[$alg]} "$TEST_USER@$TEST_HOST" true >/dev/null 2>&1
    retcode=$?
    end_ep="$(date +%s.%N)"
    lat_ms="$(python3 -c "s=$start_ep;e=$end_ep;print(f'{(e-s)*1000:.2f}')" 2>/dev/null || echo NA)"
    success=0; [[ "$retcode" -eq 0 ]] && success=1
    echo "${alg},${RTT_MS},1,${i},${lat_ms},${success},${retcode}" >> "$RAW_CSV"
  done

  # Print progress every 10 rounds
  if (( i % 10 == 0 )); then
    echo "[$(date +%H:%M:%S)] interleaved batch $((i+1))/$ITERATIONS"
  fi
done

echo ""
echo "================================================"
echo "  Test5 complete!"
echo "================================================"

# Summary (using dedicated analysis script)
if command -v python3 >/dev/null 2>&1; then
  python3 "$SCRIPT_DIR/analyze_test5.py" "$RAW_CSV" "$SUMMARY_CSV" "$RESULT_DIR/test5_report.md" 2>/dev/null || {
    # Fallback: inline summary
    echo "[WARN] analyze_test5.py failed, using inline fallback"
    python3 -c "
import csv
from collections import defaultdict
rows = []
with open('$RAW_CSV') as f:
    for r in csv.DictReader(f):
        rows.append(r)
groups = defaultdict(list)
for r in rows:
    lt = r.get('latency_ms','NA')
    if lt != 'NA': groups[r['alg']].append(float(lt))
with open('$SUMMARY_CSV','w') as f:
    f.write('alg,total,successes,p50_ms,p95_ms,mean_ms\n')
    for alg in sorted(groups.keys()):
        lats = sorted(groups[alg])
        n = len(lats)
        p50 = lats[int(n*0.50)]
        p95 = lats[min(int(n*0.95),n-1)]
        mean_val = sum(lats)/n
        f.write(f'{alg},{n},{n},{p50:.2f},{p95:.2f},{mean_val:.2f}\n')
print('Summary written to $SUMMARY_CSV')
for alg in sorted(groups.keys()):
    lats = sorted(groups[alg])
    print(f'  {alg}: n={len(lats)} p50={lats[int(len(lats)*0.50)]:.2f}ms p95={lats[min(int(len(lats)*0.95),len(lats)-1)]:.2f}ms')
"
  }
else
  echo "[WARN] python3 not found, skipping analysis"
fi
