# Pending KEM Challenge counter instrumentation patch
#
# Purpose: Add atomic counters in ssh-kem.c and auth2-kem.c to
#          track current pending challenge count and peak.
#
# Apply:
#   cd /home/toki/KEMSSH/KEMSSH
#   patch -p1 < test/newTest/test2/patch/pending_counter.patch
#   make clean
#   CFLAGS="-DKEM_TEST_INSTRUMENTATION" make -j4 sshd ssh
#
# Revert:
#   git checkout -- ssh-kem.c auth2-kem.c
#   make clean && make -j4 sshd ssh

--- a/ssh-kem.c
+++ b/ssh-kem.c
@@ -30,6 +30,15 @@
 #include "ssh-kem.h"
 #include "oqs-utils.h"

+#ifdef KEM_TEST_INSTRUMENTATION
+#include <stdatomic.h>
+atomic_int kem_pending_count = 0;
+atomic_int kem_pending_peak = 0;
+
+/* Read pending count (for external scripts to query via signal or file) */
+void kem_test_write_pending_count(const char *path);
+#endif
+
 /* KEM algorithm definitions */
 struct kem_alg {
 	const char *name;
@@ -280,6 +289,25 @@
 	return r;
 }

+#ifdef KEM_TEST_INSTRUMENTATION
+void
+kem_test_inc_pending(void)
+{
+	int cur = atomic_fetch_add(&kem_pending_count, 1) + 1;
+	int peak = atomic_load(&kem_pending_peak);
+	while (cur > peak) {
+		if (atomic_compare_exchange_weak(&kem_pending_peak, &peak, cur))
+			break;
+	}
+}
+
+void
+kem_test_dec_pending(void)
+{
+	atomic_fetch_sub(&kem_pending_count, 1);
+}
+#endif
+
 int
 kem_encapsulate(const char *alg_name, const u_char *pubkey, size_t pubkey_len,
     u_char **ciphertext, size_t *ciphertext_len,

--- a/ssh-kem.h
+++ b/ssh-kem.h
@@ -65,4 +65,14 @@
 int kem_derive_response(const u_char *shared_secret, size_t ss_len,
     const u_char *session_id, size_t session_id_len,
     const u_char *transcript, size_t transcript_len,
     u_char **response, size_t *response_len);
+
+#ifdef KEM_TEST_INSTRUMENTATION
+#include <stdatomic.h>
+extern atomic_int kem_pending_count;
+extern atomic_int kem_pending_peak;
+
+void kem_test_inc_pending(void);
+void kem_test_dec_pending(void);
+#endif
+
 #endif /* SSH_KEM_H */

--- a/auth2-kem.c
+++ b/auth2-kem.c
@@ -150,6 +150,10 @@
 	debug("KEM: encapsulate success, ct_len=%zu, ss_len=%zu",
 	    ct_len, ss_len);

+#ifdef KEM_TEST_INSTRUMENTATION
+	kem_test_inc_pending();
+#endif
+
 	/* Store KEM context in authctxt for later verification */
 	authctxt->kem_ctx = kem_ctx;
 	authctxt->kem_alg_name = xstrdup(alg_name);
@@ -220,6 +224,10 @@
 	}

  cleanup:
+#ifdef KEM_TEST_INSTRUMENTATION
+	if (authctxt->kem_ctx != NULL)
+		kem_test_dec_pending();
+#endif
 	if (authctxt->kem_ctx != NULL) {
 		kem_free_ctx(authctxt->kem_ctx);
 		authctxt->kem_ctx = NULL;
@@ -280,6 +288,10 @@
 {
 	debug("KEM: stopping, freeing authctxt KEM state");
 	if (authctxt != NULL) {
+#ifdef KEM_TEST_INSTRUMENTATION
+		if (authctxt->kem_ctx != NULL)
+			kem_test_dec_pending();
+#endif
 		if (authctxt->kem_ctx != NULL) {
 			kem_free_ctx(authctxt->kem_ctx);
 			authctxt->kem_ctx = NULL;

