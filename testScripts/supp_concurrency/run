#!/usr/bin/env bash
# supp_concurrency/run — Top-level entry for concurrency experiments
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
THRU_DIR="$ROOT_DIR/testScripts/supp_concurrency/throughput_cgroup"
PEND_DIR="$ROOT_DIR/testScripts/supp_concurrency/pending_memory"

usage() {
    cat <<'EOF'
Usage:
  bash testScripts/supp_concurrency/run [--mode throughput|pending|all]

Options:
  --mode throughput   Run throughput + cgroup experiment only
  --mode pending      Run pending memory experiment only
  --mode all          Run both (default)
EOF
}

MODE="${1:-all}"
case "$MODE" in
    --mode) MODE="$2";;
esac

if [[ "$MODE" == "throughput" || "$MODE" == "all" ]]; then
    echo "[STEP] supp_concurrency: throughput_cgroup"
    sudo bash "$THRU_DIR/run"
fi

if [[ "$MODE" == "pending" || "$MODE" == "all" ]]; then
    echo "[STEP] supp_concurrency: pending_memory"
    sudo bash "$PEND_DIR/run"
fi

echo "[OK] supp_concurrency complete"
