#!/usr/bin/env bash
# supp_rtt_loss/run — Top-level entry for RTT + loss experiments
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
RTT_DIR="$ROOT_DIR/testScripts/supp_rtt_loss/rtt_scan"
LOSS_DIR="$ROOT_DIR/testScripts/supp_rtt_loss/loss"

usage() {
    cat <<'EOF'
Usage:
  bash testScripts/supp_rtt_loss/run [--mode rtt|loss|all]

Options:
  --mode rtt    Run RTT dense scan only
  --mode loss   Run random loss experiment only
  --mode all    Run both (default)
EOF
}

MODE="${1:-all}"
case "$MODE" in
    --mode) MODE="$2";;
esac

if [[ "$MODE" == "rtt" || "$MODE" == "all" ]]; then
    echo "[STEP] supp_rtt_loss: rtt_scan"
    sudo bash "$RTT_DIR/run"
fi

if [[ "$MODE" == "loss" || "$MODE" == "all" ]]; then
    echo "[STEP] supp_rtt_loss: loss"
    sudo bash "$LOSS_DIR/run"
fi

echo "[OK] supp_rtt_loss complete"
