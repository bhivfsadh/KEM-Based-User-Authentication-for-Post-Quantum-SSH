# Ciphertext Mutation Hook patch
#
# Purpose: introduce a mutation hook before send_kem_challenge() sends the
#   ciphertext, so the server can send modified ciphertexts to the client.
#   Also outputs precise timestamps in send_kem_challenge() and
#   input_userauth_kem_response() to stderr for L_remote calculation.
#
# Apply:
#   cd <repo-root>
#   patch -p1 < test/newTest/test3/patch/mutation_server.patch
#   make clean
#   CFLAGS="-DKEM_TEST_MUTATION" make -j4 sshd ssh
#
# Revert:
#   git checkout -- auth2-kem.c
#   make clean && make -j4 sshd ssh

--- a/auth2-kem.c	2026-07-28 18:00:46.449956554 +0800
+++ b/auth2-kem.c	2026-07-28 18:11:07.517810007 +0800
@@ -136,6 +136,35 @@
 send_kem_challenge(struct ssh *ssh, struct kem_authctxt *ctx)
 {
 	int r;
+#ifdef KEM_TEST_MUTATION
+	/* experiment 3: ciphertext mutation hook */
+	{
+		const char *mut = getenv("KEM_MUTATION_TYPE");
+		size_t ct_len = ctx->ciphertext_len;
+		if (mut && strcmp(mut, "valid") != 0) {
+			if (strcmp(mut, "onebit") == 0) {
+				int bit = arc4random_uniform(ct_len * 8);
+				ctx->ciphertext[bit / 8] ^= (1 << (bit % 8));
+			} else if (strcmp(mut, "multibit") == 0) {
+				int nflips = (ct_len * 8) / 100 + 1;
+				for (int k = 0; k < nflips; k++) {
+					int bit = arc4random_uniform(ct_len * 8);
+					ctx->ciphertext[bit / 8] ^= (1 << (bit % 8));
+				}
+			} else if (strcmp(mut, "random") == 0) {
+				arc4random_buf(ctx->ciphertext, ct_len);
+			} else if (strcmp(mut, "allzero") == 0) {
+				memset(ctx->ciphertext, 0, ct_len);
+			} else if (strcmp(mut, "allff") == 0) {
+				memset(ctx->ciphertext, 0xff, ct_len);
+			} else if (strcmp(mut, "truncated") == 0) {
+				if (ct_len > 1) ctx->ciphertext_len = ct_len - 1;
+			} else if (strcmp(mut, "extended") == 0) {
+				ctx->ciphertext_len = ct_len + 1;
+			}
+		}
+	}
+#endif
 
 	if ((r = sshpkt_start(ssh, SSH2_MSG_USERAUTH_KEM_CHALLENGE)) != 0 ||
 	    (r = sshpkt_put_cstring(ssh, ctx->alg)) != 0 ||
@@ -144,6 +173,14 @@
 	    (r = sshpkt_send(ssh)) != 0) {
 		return r;
 	}
+#ifdef KEM_TEST_MUTATION
+	{
+		struct timespec ts;
+		clock_gettime(CLOCK_MONOTONIC, &ts);
+		fprintf(stderr, "KEM_CHALLENGE_EPOCH:%ld.%09ld\n",
+		    (long)ts.tv_sec, (long)ts.tv_nsec);
+	}
+#endif
 	return 0;
 }
 
@@ -152,6 +189,14 @@
 {
 	Authctxt *authctxt = ssh->authctxt;
 	struct kem_authctxt *ctx = authctxt != NULL ? authctxt->methoddata : NULL;
+#ifdef KEM_TEST_MUTATION
+	{
+		struct timespec ts;
+		clock_gettime(CLOCK_MONOTONIC, &ts);
+		fprintf(stderr, "KEM_RESPONSE_EPOCH:%ld.%09ld\n",
+		    (long)ts.tv_sec, (long)ts.tv_nsec);
+	}
+#endif
 	char *alg = NULL, *packet_method = NULL;
 	size_t response_len = 0;
 	u_char *response = NULL;
